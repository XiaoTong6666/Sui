# Allow adbd to transition to %su_secon%:s0 context
allow adbd adbd process setcurrent
allow adbd %su_secon% process dyntransition

# Allow the Sui shell child to transition from the root implementation domain to shell.
allow %su_secon% %su_secon% process setcurrent
allow %su_secon% shell process dyntransition

# Fix "adb install" under "adb root"
allow system_server %su_secon% unix_stream_socket { getopt getattr read write }

# Fix cannot start. Keep this base file limited to API 23 policy vocabulary;
# newer permissions/classes are appended by customize.sh.
allow adbd %adb_data_file_secon% dir { search getattr }
allow adbd %adb_data_file_secon% file { getattr execute execute_no_trans read open }
